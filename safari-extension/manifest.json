{
  "manifest_version": 3,
  "name": "Home Hub — Safari",
  "version": "0.8.2",
  "description": "Sua casa no Safari: acessórios, cômodos, relógio, calendário e previsão do tempo.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://home.google.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "background": {
    "service_worker": "weather-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://home.google.com/*"
      ],
      "css": [
        "theme.css",
        "widgets.css",
        "ambient.css",
        "safari.css"
      ],
      "js": [
        "widgets.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-1024.png"
  }
}
