{
  "manifest_version": 3,
  "name": "Home Hub — tema Apple para Google Home",
  "version": "0.7.1",
  "description": "Google Home Web com dock flutuante, relógio, calendário, previsão do tempo e modo ambiente.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*"],
  "background": {"service_worker": "weather-worker.js"},
  "content_scripts": [
    {
      "matches": ["https://home.google.com/*"],
      "css": ["theme.css", "widgets.css", "ambient.css"],
      "js": ["widgets.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
